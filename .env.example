# Copy to .env. Wrangler reads .env and .env.local for local development;
# both are git-ignored. On Freebuff Sites, set GROQ_API_KEY in Sites → Secrets.

# Your Groq API key (gsk_…). Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to https://api.groq.com/openai/v1
# GROQ_BASE_URL=

# Optional: real Sign in with Freebuff on localhost, from sites_enable_auth's
# development variables. Without them a local development user is used.
# FREEBUFF_CLIENT_ID=
# FREEBUFF_ISSUER=https://freebuff.com/oidc
# APP_ORIGIN=http://localhost:5173
